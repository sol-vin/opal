[20.57, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m [*] OPAL TUI SHOWCASE ── Slide 8/34: [TrueColor Engine & Palettes] ── [Architecture & Code]\u001b[0m    \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m>> 24-Bit TrueColor & Color Interpolation\u001b[0m                                                     \u001b[0m\u001b[5;1H  \u001b[0m\u001b[37mFull RGB (16.7M colors), automatic 256-color fallback, hex parsing/formatting, and lerp.\u001b[0m      \u001b[0m\u001b[6;1H                                                                                                \u001b[0m\u001b[7;1H  \u001b[0m\u001b[38;2;108;112;134m  1 │ \u001b[0mrequire \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                                          \u001b[0m\u001b[8;1H  \u001b[0m\u001b[38;2;108;112;134m  2 │ \u001b[0m                                                                                        \u001b[0m\u001b[9;1H  \u001b[0m\u001b[38;2;108;112;134m  3 │ \u001b[0m\u001b[2m\u001b[90m# Standalone interactive color picker prompt:\u001b[0m                                           \u001b[0m\u001b[10;1H  \u001b[0m\u001b[38;2;108;112;134m  4 │ \u001b[0mcolor = Opal.pick_color(Opal:\u001b[0m\u001b[33m:Color\u001b[0m.hex(\"\u001b[0m\u001b[2m\u001b[90m#CBA6F7\"))\u001b[0m                                     \u001b[0m\u001b[11;1H  \u001b[0m\u001b[38;2;108;112;134m  5 │ \u001b[0mputs \"Picked color: \u001b[0m\u001b[2m\u001b[90m#{color.to_hex}\" if color\u001b[0m                                           \u001b[0m\u001b[12;1H  \u001b[0m\u001b[38;2;108;112;134m  6 │ \u001b[0m                                                                                        \u001b[0m\u001b[13;1H  \u001b[0m\u001b[38;2;108;112;134m  7 │ \u001b[0m\u001b[2m\u001b[90m# Smooth color gradients with linear interpolation:\u001b[0m                                     \u001b[0m\u001b[14;1H  \u001b[0m\u001b[38;2;108;112;134m  8 │ \u001b[0mc_start = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.green                                                             \u001b[0m\u001b[15;1H  \u001b[0m\u001b[38;2;108;112;134m  9 │ \u001b[0mc_alert = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.red                                                               \u001b[0m\u001b[16;1H  \u001b[0m\u001b[38;2;108;112;134m 10 │ \u001b[0mhalfway = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.lerp(c_start, c_alert, \u001b[0m\u001b[33m0.5\u001b[0m)                                       \u001b[0m\u001b[17;1H  \u001b[0m\u001b[38;2;108;112;134m 11 │ \u001b[0m                                                                                        \u001b[0m\u001b[18;1H  \u001b[0m\u001b[38;2;108;112;134m 12 │ \u001b[0m\u001b[2m\u001b[90m# Declarative styling with 24-bit RGB:\u001b[0m                                                  \u001b[0m\u001b[19;1H  \u001b[0m\u001b[38;2;108;112;134m 13 │ \u001b[0mstyle = Opal.style.foreground(color).bold                                               \u001b[0m\u001b[20;1H  \u001b[0m\u001b[38;2;108;112;134m 14 │ \u001b[0mputs style.render(\u001b[0m\u001b[32m\"Styled in TrueColor!\"\u001b[0m)                                               \u001b[0m\u001b[21;1H                                                                                                \u001b[0m\u001b[22;1H                                                                                                \u001b[0m\u001b[23;1H                                                                                                \u001b[0m\u001b[24;1H                                                                                                \u001b[0m\u001b[25;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[26;1H\u001b[0m\u001b[97m [Shift+→] Next  [Shift+←] Prev  [ESC] Quit │ 24-Bit TrueColor RGB • Linear Gradients • Palettes\u001b[0m"]
