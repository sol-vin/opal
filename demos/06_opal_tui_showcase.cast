[17.355, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m❖ OPAL TUI ── Slide 4/13: [App Mockup: OpalChat (2-Pane Split)]\u001b[0m                       \u001b[0m\u001b[1m\u001b[38;2;56;239;125m[c] </> Code\u001b[0m \u001b[0m\u001b[1m\u001b[38;2;0;242;254m[?] Guide\u001b[0m  \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                              \u001b[0m\u001b[4;1H \u001b[0m\u001b[96m╭─\u001b[0m\u001b[1m\u001b[38;2;245;194;231m OpalChat Network \u001b[0m\u001b[96m─────╮\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m╭─\u001b[0m\u001b[1m\u001b[38;2;245;194;231m Channel: # core-development \u001b[0m\u001b[38;2;56;239;125m─────────────────────────────────────────────────╮\u001b[0m\u001b[5;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m                                                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[6;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[1m\u001b[97mCHANNELS:\u001b[0m              \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@sol.vin\u001b[0m \u001b[0m\u001b[95m[ADMIN]\u001b[0m \u001b[0m\u001b[90m14:02\u001b[0m                                                        \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[7;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97mWelcome everyone to Opal 2.0!\u001b[0m                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[8;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[96m # general \u001b[0m            \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001