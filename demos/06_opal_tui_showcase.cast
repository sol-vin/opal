m  7 │ \u001b[0m\u001b[2m\u001b[90m# Smooth color gradients with linear interpolation:\u001b[0m                                     \u001b[0m\u001b[14;1H  \u001b[0m\u001b[38;2;108;112;134m  8 │ \u001b[0mc_start = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.green                                                             \u001b[0m\u001b[15;1H  \u001b[0m\u001b[38;2;108;112;134m  9 │ \u001b[0mc_alert = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.red                                                               \u001b[0m\u001b[16;1H  \u001b[0m\u001b[38;2;108;112;134m 10 │ \u001b[0mhalfway = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.lerp(c_start, c_alert, \u001b[0m\u001b[33m0.5\u001b[0m)                                       \u001b[0m\u001b[17;1H  \u001b[0m\u001b[38;2;108;112;134m 11 │ \u001b[0m                                                                                        \u001b[0m\u001b[18;1H  \u001b[0m\u001b[38;2;108;112;134m 12 │ \u001b[0m\u001b[2m\u001b[90m# Declarative styling with 24-bit RGB:\u001b[0m                                                  \u001b[0m\u001b[19;1H  \u001b[0m\u001b[38;2;108;112;134m 13 │ \u001b[0mstyle = Opal.style.foreground(color).bold                                               \u001b[0m\u001b[20;1H  \u001b[0m\u001b[38;2;108;112;134m 14 │ \u001b[0mputs style.render(\u001b[0m\u001b[32m\"Styled in TrueColor!\"\u001b[0m)                                               \u001b[0m\u001b[21;1H                                                                                                \u001b[0m\u001b[22;1H                                                                                                \u001b[0m\u001b[23;1H                                                                                                \u001b[0m\u001b[24;1H                                                                                                \u001b[0m\u001b[25;1H\u001b[0m\u001b[90m─────────────────────────────────────────────────────────────────────────────