[14.62, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m❖ OPAL TUI ── Slide 4/13: [App Mockup: OpalChat (2-Pane Split)]\u001b[0m                       \u001b[0m\u001b[1m\u001b[38;2;56;239;125m[c] </> Code\u001b[0m \u001b[0m\u001b[1m\u001b[38;2;0;242;254m[?] Guide\u001b[0m  \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                              \u001b[0m\u001b[4;1H \u001b[0m\u001b[96m╭─\u001b[0m\u001b[1m\u001b[38;2;245;194;231m OpalChat Network \u001b[0m\u001b[96m─────╮\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m╭─\u001b[0m\u001b[1m\u001b[38;2;245;194;231m Channel: # general \u001b[0m\u001b[38;2;56;239;125m──────────────────────────────────────────────────────────╮\u001b[0m\u001b[5;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m                                                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[6;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[1m\u001b[97mCHANNELS:\u001b[0m              \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@sol.vin\u001b[0m \u001b[0m\u001b[95m[ADMIN]\u001b[0m \u001b[0m\u001b[90m14:02\u001b[0m                                                        \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[7;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97mWelcome everyone to Opal 2.0!\u001b[0m                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[8;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[1m\u001b[93m\u001b[48;2;30;58;138m ▶ general \u001b[0m            \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@ian\u001b[0m \u001b[0m\u001b[95m[DEV]\u001b[0m \u001b[0m\u001b[90m14:05\u001b[0m                                                              \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[9;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[96m # core-development \u001b[0m   \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97mThe new fixed-timestep 60Hz loop is buttery smooth.\u001b[0m                         \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[10;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[96m # ui-showcase \u001b[0m        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@reviewer\u001b[0m \u001b[0m\u001b[95m[QA]\u001b[0m \u001b[0m\u001b[90m14:07\u001b[0m                                                          \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[11;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[96m # announcements \u001b[0m      \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97mChecking the 2-pane chat mockup. Zero text overflow!\u001b[0m                        \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[12;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@sol.vin\u001b[0m \u001b[0m\u001b[95m[ADMIN]\u001b[0m \u001b[0m\u001b[90m14:10\u001b[0m                                                        \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[13;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97mTesting code block rendering inside chat message:\u001b[0m                           \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[14;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[1m\u001b[97mDIRECT MESSAGES:\u001b[0m       \u001b