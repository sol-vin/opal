uction on save? \u001b[0m\u001b[1m\u001b[30m\u001b[42m[ Yes ]\u001b[0m \u001b[0m\u001b[90m[ No ]\u001b[0m                                         \u001b[0m\u001b[15;1H                                                                                                \u001b[0m\u001b[16;1H                                                                                                \u001b[0m\u001b[17;1H  \u001b[0m\u001b[36m└─\u001b[0m\u001b[90m [Tab/Shift+Tab] Move   [Enter] Submit   [Esc] Cancel \u001b[0m\u001b[36m─────────┘\u001b[0m                            \u001b[0m\u001b[18;1H                                                                                                \u001b[0m\u001b[19;1H                                                                                                \u001b[0m\u001b[20;1H                                                                                                \u001b[0m\u001b[21;1H    \u001b[0m\u001b[36mℹ Edit fields with Tab/Space. Press [Enter] to validate.\u001b[0m                                    \u001b[0m\u001b[22;1H                                                                                                \u001b[0m\u001b[23;1H                                                                                                \u001b[0m\u001b[24;1H                                                                                                \u001b[0m\u001b[25;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[26;1H\u001b[0m\u001b[97m [ESC / → / n] Next  [← / p] Prev  [q] Quit │ [Tab/Shift+Tab] Move Field   [Space] Toggle/Select\u001b[0m"]
[11.122,"o","\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m 💎 OPAL TUI SHOWCASE ── Slide 3/23: [Form DSL Architecture] ── [Architecture & Code]\u001b[0m           \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m📝 Why Multi-Field Forms Matter\u001b[0m                                                               \u001b[0m\u001b[5;1H  \u001b[0m\u001b[37mTraditional CLI wizards ask one question at a time and prevent correcting prior fields.\u001b[0m       \u001b[0m\u001b[6;1H  \u001b[0m\u001b[37mOpal presents an interactive card where all inputs are visible simultaneously with live valida\u001b[0m\u001b[7;1H                                                                                                \u001b[0m\u001b[8;1H    1 │ require \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                                          \u001b[0m\u001b[9;1H    2 │                                                                                         \u001b[0m\u001b[10;1H    3 │ config = Opal.form(\u001b[0m\u001b[32m\"Cluster Setup\"\u001b[0m) \u001b[0m\u001b[1m\u001b[35mdo\u001b[0m |f|                                              \u001b[0m\u001b[11;1H    4 │   f.text \u001b[0m\u001b[32m\"cluster\"\u001b[0m, \u001b[0m\u001b[32m\"Cluster Name:\"\u001b[0m, required: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m                                     \u001b[0m\u001b[12;1H    5 │   f.password \u001b[0m\u001b[32m\"token\"\u001b[0m, \u001b[0m\u001b[32m\"API Token:\"\u001b[0m, min_length: \u001b[0m\u001b[33m8\u001b[0m                                       \u001b[0m\u001b[13;1H    6 │   f.select \u001b[0m\u001b[32m\"region\"\u001b[0m, \u001b[0m\u001b[32m\"Region:\"\u001b[0m, [\u001b[0m\u001b[32m\"us-east\"\u001b[0m, \u001b[0m\u001b[32m\"eu-central\"\u001b[0m]                               \u001b[0m\u001b[14;1H    7 │   f.multi_select \u001b[0m\u001b[32m\"addons\"\u001b[0m, \u001b[0m\u001b[32m\"Addons:\"\u001b[0m, [\u001b[0m\u001b[32m\"Redis\"\u001b[0m, \u001b[0m\u001b[32m\"Kafka\"\u001b[0m, \u001b[0m\u001b[32m\"Metrics\"\u001b[0m]                     \u001b[0m\u001b[15;1H    8 │   f.confirm \u001b[0m\u001b[32m\"deploy\"\u001b[0m, \u001b[0m\u001b[32m\"Deploy now?\"\u001b[0m, default: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m                                      \u001b[0m\u001b[16;1H    9 │                                                                                         \u001b[0m\u001b[17;1H   10 │   f.validate \u001b[0m\u001b[32m\"cluster\"\u001b[0m \u001b[0m\u001b[1m\u001b[35mdo\u001b[0m |val|                                                         \u001b[0m\u001b[18;1H   11 │     val =~ /^[a-z0-\u001b[0m\u001b[33m9\u001b[0m-]+$/ ? \u001b[0m\u001b[1m\u001b[35mnil\u001b[0m : \u001b[0m\u001b[32m\"Lowercase alphanumeric & dashes only\"\u001b[0m                \u001b[0m\u001b[19;1H   12 │   \u001b[0m\u001b[1m\u001b[35mend\u001b[0m                                                                                   \u001b[0m\u001b[20;1H   13 │ \u001b[0m\u001b[1m\u001b[35mend\u001b[0m                                                                                     \u001b[0m\u001b[21;1H                                                                                                \u001b[0m\u001b[22;1H                                                                                                \u001b[0m\u001b[23;1H                                                                                                \u001b[0m\u001b[24;1H                                                                                                \u001b[0m\u001b[25;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[26;1H\u001b[0m