10;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[90m[ ]\u001b[0m \u001b[0m\u001b[97m24-bi\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  4 │ \u001b[0m\u001b[2m\u001b[90m# Verify terminal environment capabilities\u001b[0m                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[11;1H        \u001b[0m\u001b[90m16.7M\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  5 │ \u001b[0mdriver = Opal:\u001b[0m\u001b[33m:Terminal\u001b[0m.default_driver                                    \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[12;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  6 │ \u001b[0mcols, rows = driver.size                                                  \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[13;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[90m[ ]\u001b[0m \u001b[0m\u001b[97mUnico\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  7 │ \u001b[0m                                                                          \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[14;1H        \u001b[0m\u001b[90mShadi\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  8 │ \u001b[0mputs \u001b[0m\u001b[32m\"Opal TUI Framework by sol.vin (Ian Rash)\"\u001b[0m                           \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[15;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  9 │ \u001b[0mputs \"TrueColor Support : \u001b[0m\u001b[2m\u001b[90m#{driver.supports_truecolor?}\"\u001b[0m                  \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001