[19.95,"o","\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m 💎 OPAL TUI SHOWCASE ── Slide 8/26: [TrueColor Engine & Palettes] ── [Architecture & Code]\u001b[0m     \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m🎨 24-Bit TrueColor & Color Interpolation\u001b[0m                                                     \u001b[0m\u001b[5;1H  \u001b[0m\u001b[37mFull RGB (16.7M colors), automatic 256-color fallback, hex parsing/formatting, and lerp.\u001b[0m      \u001b[0m\u001b[6;1H                                                                                                \u001b[0m\u001b[7;1H    1 │ require \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                                          \u001b[0m\u001b[8;1H    2 │                                                                                         \u001b[0m\u001b[9;1H    3 │ \u001b[0m\u001b[2m\u001b[90m# Standalone interactive color picker prompt:\u001b[0m                                           \u001b[0m\u001b[10;1H    4 │ color = Opal.pick_color(Opal:\u001b[0m\u001b[33m:Color\u001b[0m.hex(\"\u001b[0m\u001b[2m\u001b[90m#CBA6F7\"))\u001b[0m                                     \u001b[0m\u001b[11;1H    5 │ puts \"Picked color: \u001b[0m\u001b[2m\u001b[90m#{color.to_hex}\" if color\u001b[0m                                           \u001b[0m\u001b[12;1H    6 │                                                                                         \u001b[0m\u001b[13;1H    7 │ \u001b[0m\u001b[2m\u001b[90m# Smooth color gradients with linear interpolation:\u001b[0m                                     \u001b[0m\u001b[14;1H    8 │ c_start = Opal:\u001b[0m\u001b[33m:Color\u001b[0m.green                                                             \u0