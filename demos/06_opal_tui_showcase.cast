[9.41, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m [*] OPAL TUI SHOWCASE ── Slide 3/34: [Form DSL Architecture] ── [Architecture & Code]\u001b[0m          \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m>> Why Multi-Field Forms Matter\u001b[0m                                                               \u001b[0m\u001b[5;1H  \u001b[0m\u001b[37mTraditional CLI wizards ask one question at a time and prevent correcting prior fields.\u001b[0m       \u001b[0m\u001b[6;1H  \u001b[0m\u001b[37mOpal presents an interactive card where all inputs are visible simultaneously with live valida\u001b[0m\u001b[7;1H                                                                                                \u001b[0m\u001b[8;1H  \u001b[0m\u001b[38;2;108;112;134m  1 │ \u001b[0mrequire \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                                          \u001b[0m\u001b[9;1H  \u001b[0m\u001b[38;2;108;112;134m  2 │ \u001b[0m                                                                                        \u001b[0m\u001b[10;1H  \u001b[0m\u001b[38;2;108;112;134m  3 │ \u001b[0mconfig = Opal.form(\u001b[0m\u001b[32m\"Cluster Setup\"\u001b[0m) \u001b[0m\u001b[1m\u001b[35mdo\u001b[0m |f|                                              \u001b[0m\u001b[11;1H  \u001b[0m\u001b[38;2;108;112;134m  4 │ \u001b[0m  f.text \u001b[0m\u001b[32m\"cluster\"\u001b[0m, \u001b[0m\u001b[32m\"Cluster Name:\"\u001b[0m, required: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m                                     \u001b[0m\u001b[12;1H  \u001b[0m\u001b[38;2;108;112;134m  5 │ \u001b[0m  f.password \u001b[0m\u001b[32m\"token\"\u001b[0m, \u001b[0m\u001b[32m\"API Token:\"\u001b[0m, min_length: \u001b[0m\u001b[33m8\u001b[0m                                       \u001b[0m\u001b[13;1H  \u001b[0m\u001b[38;2;108;112;134m  6 │ \u001b[0m  f.select \u001b[0m\u001b[32m\"region\"\u001b[0m, \u001b[0m\u001b[32m\"Region:\"\u001b[0m, [\u001b[0m\u001b[32m\"us-east\"\u001b[0m, \u001b[0m\u001b[32m\"eu-central\"\u001b[0m]                               \u001b[0m\u001b[14;1H  \u001b[0m\u001b[38;2;108;112;134m  7 │ \u001b[0m  f.multi_select \u001b[0m\u001b[32m\"addons\"\u001b[0m, \u001b[0m\u001b[32m\"Addons:\"\u001b[0m, [\u001b[0m\u001b[32m\"Redis\"\u001b[0m, \u001b[0m\u001b[32m\"Kafka\"\u001b[0m, \u001b[0m\u001b[32m\"Metrics\"\u001b[0m]                     \u001b[0m\u001b[15;1H  \u001b[0m\u001b[38;2;108;112;134m  8 │ \u001b[0m  f.confirm \u001b[0m\u001b[32m\"deploy\"\u001b[0m, \u001b[0m\u001b[32m\"Deploy now?\"\u001b[0m, default: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m                                      \u001b[0m\u001b[16;1H  \u001b[0m\u001b[38;2;108;112;134m  9 │ \u001b[0m                                                                                        \u001b[0m\u001b[17;1H  \u001b[0m\u001b[38;2;108;112;134m 10 │ \u001b[0m  f.validate \u001b[0m\u001b[32m\"cluster\"\u001b[0m \u001b[0m\u001b[1m\u001b[35mdo\u001b[0m |val|                                                         \u001b[0m\u001b[18;1H  \u001b[0m\u001b[38;2;108;112;134m 11 │ \u001b[0m    val =~ /^[a-z0-\u001b[0m\u001b[33m9\u001b[0m-]+$/ ? \u001b[0m\u001b[1m\u001b[35mnil\u001b[0m : \u001b[0m\u001b[32m\"Lowercase alphanumeric & dashes only\"\u001b[0m                \u001b[0m\u001b[19;1H  \u001b[0m\u001b[38;2;108;112;134m 12 │ \u001b[0m  \u001b[0m\u001b[1m\u001b[35mend\u001b[0m                                                                                   \u001b[0m\u001b[20;1H  \u001b[0m\u001b[38;2;108;112;134m 13 │ \u001b[0m\u001b[1m\u001b[35mend\u001b[0m                                                                                     \u001b[0m\u001b[21;1H                                                                                                \u001b[0m\u001b[22;1H                                                                                                \u001b[0m\u001b[23;1H                                                                                                \u001b[0m\u001b[24;1H                                                                                                \u001b[0m\u001b[25;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[26;1H\u001b[0m\u001b[97m [Shift+→] Next  [Shift+←] Prev  [ESC] Quit │ Pure Crystal DSL • Zero C Dependencies • Interacti\u001b[0m"]
