[0m\u001b[13;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[90m[ ]\u001b[0m \u001b[0m\u001b[97mUnicode & Nerd Font Glyphs\u001b[0m                                                                            \u001b[0m\u001b[14;1H        \u001b[0m\u001b[90mShading (░▒▓█), fractional meters (▏..█), box borders (┌─┐).\u001b[0m                                          \u001b[0m\u001b[15;1H                                                                                                              \u001b[0m\u001b[16;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[97mExtended SGR Mouse Protocol (1006)\u001b[0m                                                                    \u001b[0m\u001b[17;1H        \u001b[0m\u001b[90mPixel/cell accurate mouse click, hover, drag, and wheel tracking.\u001b[0m                                     \u001b[0m\u001b[18;1H                                                                                                              \u001b[0m\u001b[19;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[97mGamepad / Controller Subsystem\u001b[0m                                                                        \u001b[0m\u001b[20;1H        \u001b[0m\u001b[90mMock / Virtual controller active with full D-Pad focus traversal.\u001b[0m                                     \u001b[0m\u001b[21;1H                                                                                                              \u001b[0m\u001b[22;1H  \u001b[0m\u001b[1m\u001b[96m▶ \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[1m\u001b[93mTerminal Viewport Resolution\u001b[0m                                                                          \u001b[0m\u001b[23;1H        \u001b[0m\u001b[90mCurrent geometry: 80x24 cells. (Recommended: 90x28+).\u001b[0m                                                 \u001b[0m\u001b[24;1H                                                                                                              \u001b[0m\u001b[25;1H                                                                                                              \u001b[0m\u001b[26;1H    \u001b[0m\u001b[1m\u001b[96m\u001b[48;2;31;36;48m [ Launch Interactive Showcase ➔ ] \u001b[0m                                                                       \u001b[0m\u001b[27;1H                                                                                                              \u001b[0m\u001b[28;1H                                                                                                              \u001b[0m\u001b[29;1H                                                                                                              \u001b[0m\u001b[30;1H                                                                                                              \u001b[0m\u001b[31;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[32;1H\u001b[0m\u001b[97m [Shift+→] Next  [Shift+←] Prev  [c] Code  [?] Guide  [q] Quit │ [↑/↓] Select Item  │  [Space] Toggle  │  [Ent\u001b[0m"]
[3.19, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m❖ OPAL TUI ── Slide 1/13: [System Compatibility & Verification]\u001b[0m                       \u001b[0m\u001b[1m\u001b[97m\u001b[48;2;30;58;138m[c] </> Code\u001b[0m \u001b[0m\u001b[1m\u001b[38;2;0;242;254m[?] Guide\u001b[0m  \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                              \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[96m❖ OPAL TERMINAL USER INTERFACE FRAMEWORK\u001b[0m                                                                    \u001b[0m\u001b[5;1H  \u001b[0m\u001b[38;2;56;239;125mCreated by sol.vin (Ian Rash) ── Next-Gen Terminal Engineering\u001b[0m                                              \u001b[0m\u001b[6;1H  \u001b[0m\u001b[90m───────────\u001b[0m\u001b[93m╭─\u001b[0m\u001b[1m\u001b[38;2;245;194;231m SOURCE CODE: System Compatibility & Verification \u001b[0m\u001b[93m───────────────────────────────╮\u001b[0m\u001b[90m───────────\u001b[0m  \u001b[0m\u001b[7;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m                                                                                  \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[8;1H  \u001b[0m\u001b[1m\u001b[97mSYSTEM CAPA\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  1 │ \u001b[0mrequire \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                            \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[9;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  2 │ \u001b[0mrequire \u001b[0m\u001b[32m\"opal/gamepad\"\u001b[0m                                                    \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[10;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[90m[ ]\u001b[0m \u001b[0m\u001b[97m24-bi\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  3 │ \u001b[0m                                                                          \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[11;1H        \u001b[0m\u001b[90m16.7M\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  4 │ \u001b[0m\u001b[2m\u001b[90m# Verify terminal environment capabilities\u001b[0m                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[12;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  5 │ \u001b[0mdriver = Opal:\u001b[0m\u001b[33m:Terminal\u001b[0m.default_driver                                    \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[13;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[90m[ ]\u001b[0m \u001b[0m\u001b[97mUnico\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  6 │ \u001b[0mcols, rows = driver.size                                                  \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[14;1H        \u001b[0m\u001b[90mShadi\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  7 │ \u001b[0m                                                                          \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[15;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  8 │ \u001b[0mputs \u001b[0m\u001b[32m\"Opal TUI Framework by sol.vin (Ian Rash)\"\u001b[0m                           \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[16;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[97mExten\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  9 │ \u001b[0mputs \"TrueColor Support : \u001b[0m\u001b[2m\u001b[90m#{driver.supports_truecolor?}\"\u001b[0m                  \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[17;1H        \u001b[0m\u001b[90mPixel\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m 10 │ \u001b[0mputs \"Gamepad Connected : \u001b[0m\u001b[2m\u001b[90m#{Opal::Input::Gamepad.connected?}\"\u001b[0m             \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[18;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m 11 │ \u001b[0mputs \"Terminal Geometry : \u001b[0m\u001b[2m\u001b[90m#{cols}x#{rows}\"\u001b[0m                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[19;1H  \u001b[0m\u001b[1m\u001b[96m  \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[97mGamep\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m 12 │ \u001b[0m                                                                          \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[20;1H        \u001b[0m\u001b[90mMock \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m 13 │ \u001b[0m\u001b[2m\u001b[90m# Launch presentation model\u001b[0m                                               \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[21;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m 14 │ \u001b[0mOpal.run_tea(ShowcaseAppModel.new, alt_screen: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m, diff_render: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m)   \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[22;1H  \u001b[0m\u001b[1m\u001b[96m▶ \u001b[0m\u001b[1m\u001b[92m[✔]\u001b[0m \u001b[0m\u001b[1m\u001b[93mTermi\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[23;1H        \u001b[0m\u001b[90mCurre\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[24;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[25;1H             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[26;1H    \u001b[0m\u001b[1m\u001b[96m\u001b[48;2;31;36;48m [ Launch\u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m                                                                                  \u001b[0m\u001b[93m│\u001b[0m             \u001b[0m\u001b[27;1H             \u001b[0m\u001b[93m╰─\u001b[0m\u001b[90m\u001b[48;2;15;23;42m [ESC] Close  │  [↑/↓] [PageUp/Down] Scroll \u001b[0m\u001b[93m─────────────────────────────────────╯\u001b[0m             \u001b[0m\u001b[28;1H                                                                                                              \u001b[0m\u001b[29;1H                                                                                                              \u001b[0m\u001b[30;1H                                                   