[41.285, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m❖ OPAL TUI ── Slide 10/13: [Dropdown Styles & Fractional Meters]\u001b[0m                      \u001b[0m\u001b[1m\u001b[38;2;56;239;125m[c] </> Code\u001b[0m \u001b[0m\u001b[1m\u001b[38;2;0;242;254m[?] Guide\u001b[0m  \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                              \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[96m6 MULTI-STYLE DROPDOWN PRESETS:\u001b[0m                             \u001b[0m\u001b[1m\u001b[92m1/8th FRACTIONAL BLOCK METERS:\u001b[0m                  \u001b[0m\u001b[5;1H                                                                                                              \u001b[0m\u001b[6;1H  \u001b[0m\u001b[1m\u001b[93m▶ 1. Classic Style:\u001b[0m       \u001b[0m\u001b[38;2;69;71;90m[ \u001b[0m\u001b[38;2;205;214;244mProduction Deployment\u001b[0m     \u001b[0m\u001b[1m\u001b[38;2;69;71;90m▼ ]\u001b[0m   \u001b[0m\u001b[97mHeat Gradient [72%]:\u001b[0m                            \u001b[0m\u001b[7;1H                                                              \u001b[0m\u001b[38;2;56;239;125m\u001b[48;2;30;41;59m███████████████\u001b[0m\u001b[38;2;255;210;0m\u001b[48;2;30;41;59m██████▋  \u001b[0m\u001b[38;2;255;8;68m\u001b[48;2;30;41;59m      \u001b[0m                  \u001b[0m\u001b[8;1H  \u001b[0m\u001b[97m  2. Rounded Style:\u001b[0m       \u001b[0m\u001b[38;2;69;71;90m╭─ \u001b[0m\u001b[38;2;205;214;244mProduction Deployment\u001b[0m   \u001b[0m\u001b[1m\u001b[38;2;69;71;90m▼─╮\u001b[0m                                                    \u001b[0m\u001b[9;1H                                                              \u001b[0m\u001b[97mCool Gradient [72%]:\u001b[0m                            \u001b[0m\u001b[10;1H  \u001b[0m\u001b[97m  3. Minimal Style: