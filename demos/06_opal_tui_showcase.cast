[14.22, "o", "\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m❖ OPAL TUI ── Slide 3/13: [Scissor Clipping & Buffer Operations]\u001b[0m                      \u001b[0m\u001b[1m\u001b[38;2;56;239;125m[c] </> Code\u001b[0m \u001b[0m\u001b[1m\u001b[38;2;0;242;254m[?] Guide\u001b[0m  \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                              \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[96mSCISSOR TEST CONTAINER (Bounded Viewport):\u001b[0m          \u001b[0m\u001b[1m\u001b[95mBUFFER REGION OPERATIONS:\u001b[0m                               \u001b[0m\u001b[5;1H  \u001b[0m\u001b[90mContent outside scissor box is mathematically clippeDirect memory stamping, inversion, and transforms.\u001b[0m      \u001b[0m\u001b[6;1H   \u001b[0m\u001b[93m╭──────────────────────────────────────────────╮\u001b[0m                                                           \u001b[0m\u001b[7;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[97mLINE 1: 0123456789 ABCDEFGHIJKLMNOPQRSTUVWXYZ \u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m                            \u001b[0m                            \u001b[0m\u001b[8;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[92mLINE 2: ★ Wide Characters: 【日本語テスト】 🚀\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m \u001b[0m\u001b[1m\u001b[7m\u001b[37m\u001b[48;2;167;139;250m✦ BUFFER STAMP ✦\u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m         \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[9;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[36mLINE 3: ──────────────────────────────────────\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m                          \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[10;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 3: Matrix stream buffer element [3072 byte\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m \u001b[0m\u001b[7m\u001b[37m\u001b[107mBlit Mode: IgnoreSpaces\u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m  \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[11;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 4: Matrix stream buffer element [4096 byte\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m                          \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[12;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 5: Matrix stream buffer element [5120 byte\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m \u001b[0m\u001b[7m\u001b[37m\u001b[102mAlpha dithered overlay\u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[13;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 6: Matrix stream buffer element [6144 byte\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m \u001b[0m\u001b[7m\u001b[38;2;30;27;75m\u001b[40m                          \u001b[0m\u001b[48;2;30;27;75m \u001b[0m                            \u001b[0m\u001b[14;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 7: Matrix stream buffer element [7168 byte\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m                            \u001b[0m                            \u001b[0m\u001b[15;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 8: Matrix stream buffer element [8192 byte\u001b[0m\u001b[93m│\u001b[0m                                                           \u001b[0m\u