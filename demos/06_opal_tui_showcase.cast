b[48;2;8;11;17m             \u001b[0m\u001b[10;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[11;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[12;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0mOpal introduces hardware-level raster masking to terminal character buffers.    \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[13;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[14;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m### Key Concepts                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[15;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • MaskMap: A 2D floating-point grid where each cell has an alpha coverage valu\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[16;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • Feathered Dithering: Uses Unicode fractional block shades ([' ', '░', '▒', '\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[17;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • Dynamic Tracking: The spotlight can seamlessly track mouse pointers, virtual\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[18;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[19;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m### Interactive Controls                                                        \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[20;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • [W / A / S / D] or Arrow Keys: Move spotlight beam.                         \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[21;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • Mouse Click/Hover: Center light on mouse cursor.                            \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[22;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • [F]: Toggle feathered dithering on/off.                                     \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[23;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • [+] / [-]: Expand or contract spotlight radius.                             \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[24;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m  • [C]: Cycle spotlight phosphor tint color.                                   \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[25;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m                                                                                \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[26;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m                                                                                  \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[27;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m╰─\u001b[0m\u001b[90m\u001b[48;2;15;23;42m [ESC] Close  │  [↑/↓] [PageUp/Down] Scroll \u001b[0m\u001b[93m─────────────────────────────────────╯\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[28;1H\u001b[0m\u001b[48;2;8;11;17m                                                                                                              \u001b[0m\u001b[29;1H\u001b[0m\u001b[48;2;8;11;17m  \u001b[0m\u001b[1m\u001b[97m\u001b[48;2;31;41;55m SPOTLIGHT: [47, 14] │ RADIUS: 12 │ FEATHER: ON (Dithered) │ TINT: Cyber Cyan \u001b[0m\u001b[48;2;8;11;17m                              \u001b[0m\u001b[30;1H\u001b[0m\u001b[48;2;8;11;17m                                                                                                              \u001b[0m\u001b[31;1H\u001b[0m\u001b[90m──────────────────────────────────────────────────────────────────────────────────────────────────────────────\u00