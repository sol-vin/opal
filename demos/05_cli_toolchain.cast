[1.188,"o","Modern full-stack Crystal toolchain\r\n\r\n\u001b[1m\u001b[36mUsage:\u001b[0m\r\n  lapis <subcommand> [options]\r\n\r\n\u001b[1m\u001b[36mAvailable Commands:\u001b[0m\r\n  \u001b[1m\u001b[32mbuild\u001b[0m    Compile application binary\r\n  \u001b[1m\u001b[32mserve\u001b[0m    Start local development server\r\n  \u001b[1m\u001b[32mtest\u001b[0m     Run full test suite\r\n\r\n\u001b[1m\u001b[36mOptions:\u001b[0m\r\n  \u001b[33m-v, --verbose\u001b[0m    Enable debug logging\r\n\r\n\u001b[1m\u001b[36mGlobal Options:\u001b[0m\r\n  \u001b[33m-h, --help\u001b[0m       Show help screen\r\n  \u001b[33m-v, --version\u001b[0m    Show application version\r\n\r\n\r\n"]
