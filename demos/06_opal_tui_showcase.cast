[11.146,"o","\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m 💎\u001b[0m \u001b[0m\u001b[1m\u001b[96m OPAL TUI SHOWCASE ── Slide 3/23: [Form DSL Architecture] ── [Architecture & Code]\u001b[0m           \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m📝\u001b[0m \u001b[0m\u001b[1m\u001b[36m Why Multi-Field Forms Matter\u001b[0m                                                               \u001b[0m\u001b[5;1H  \u001b[0m\u001b[37mTraditional CLI wizards ask one question at a time and prevent correcting prior fields.\u001b[0m       \u001b[0m\u001b[6;1H  \u001b[0m\u001b[37mOpal presents an interactive card where all inputs are visible simultaneously with live valida\u001b[0m\u001b[7;1H                                                                                                \u001b[0m\u001b[8;1H    1 │ require \u001b[0m\u001b[32m\"opal\"\u001b[0m                                                                          \u001b[0m\u001b[9;1H    2 │                                                                                         \u001b[0m\u001b[10;1H    3 │ config = Opal.form(\u001b[0m\u001b[32m\"Cluster Setup\"\u001b[0m) \u001b[0m\u001b[1m\u001b[35mdo\u001b[0m |f|                                              \u001b[0m\u001b[11;1H    4 │   f.text \u001b[0m\u001b[32m\"cluster\"\u001b[0m, \u001b[0m\u001b[32m\"Cluster Name:\"\u001b[0m, required: \u001b[0m\u001b[1m\u001b[35mtrue\u001b[0m                                     \u001b[0m\u001b[12;1H    5 │   f.password \u001b[0m\u001b[32m\"token\"\u001b[0m, \u001b[0m\u001b[32m\"API Token:\"\u001b[0m, min_length: \u001b[0m\u001b[33m8\u001b[0m                                       \u001b[0m\u001b[13;1H    6 │   f.select \u001b[0m\u001b[32m\"region\"\u001b[0m, \u001b[0m\u001b[3