[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@sol.vin\u001b[0m \u001b[0m\u001b[95m[CODE]\u001b[0m \u001b[0m\u001b[90m14:10\u001b[0m                                                         \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[15;1H \u001b[0m\u001b[96m│\u001b[0m                        \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[38;2;255;210;0m  def pong_loop; game.step(0.0166); end\u001b[0m                                     \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[16;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[92m●\u001b[0m \u001b[0m\u001b[97m@sol.vin\u001b[0m             \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m \u001b[0m\u001b[1m\u001b[96m@ci-bot\u001b[0m \u001b[0m\u001b[95m[BOT]\u001b[0m \u001b[0m\u001b[90m14:12\u001b[0m                                                           \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[17;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[92m●\u001b[0m \u001b[0m\u001b[97m@ian\u001b[0m                 \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m   \u001b[0m\u001b[97m✔ All 715 specs passed with 0 errors across all modules.\u001b[0m                    \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[18;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[93m●\u001b[0m \u001b[0m\u001b[97m@reviewer\u001b[0m            \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m                                                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[19;1H \u001b[0m\u001b[96m│\u001b[0m \u001b[0m\u001b[90m●\u001b[0m \u001b[0m\u001b[97m@ci-bot\u001b[0m              \u001b[0m\u001b[96m│\u001b[0m  \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m                                                                               \u001b[0m\u001b[38;2;56;239;125m│\u001b[0m\u001b[20;1H \u001b[0m\u001b[96m│\