                              \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[10;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  3 │ \u001b[0m\u001b[2m\u001b[90m# 1. Create a radial alpha mask map with feathered edge dithering\u001b[0m         \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[11;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  4 │ \u001b[0mmask = Opal:\u001b[0m\u001b[33m:UI\u001b[0m:\u001b[0m\u001b[33m:MaskMap\u001b[0m.radial(                                          \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[12;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  5 │ \u001b[0m  width: \u001b[0m\u001b[33m80\u001b[0m,                                                              \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[13;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  6 │ \u001b[0m  height: \u001b[0m\u001b[33m24\u001b[0m,                                                             \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[14;1H\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[38;2;108;112;134m  7 │ \u001b[0m  cx: \u001b[0m\u001b[33m40\u001b[0m,                                                                 \u001b[0m\u001b[48;2;15;23;42m \u001b[0m\u001b[93m│\u001b[0m\u001b[48;2;8;11;17m             \u001b[0m\u001b[15;1H\u001b[0m\u001b[48;2;8;11;17m             \