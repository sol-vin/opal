[16.732,"o","\u001b[H\u001b[1;1H\u001b[0m\u001b[1m\u001b[96m 💎 OPAL TUI SHOWCASE ── Slide 4/23: [Live Fuzzy Search & Filter] ── [Interactive Search]\u001b[0m       \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H                                                                                                \u001b[0m\u001b[4;1H  \u001b[0m\u001b[1m\u001b[36m🔍 Microservice Search (Fuzzy Filter)\u001b[0m                                                         \u001b[0m\u001b[5;1H  \u001b[0m\u001b[90m─────────────────────────────────────────\u001b[0m                                                     \u001b[0m\u001b[6;1H  \u001b[0m\u001b[1m\u001b[36m> \u001b[0m\u001b[90mType to filter...\u001b[0m                                                                           \u001b[0m\u001b[7;1H  \u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m  \u001b[0m\u001b[8;1H  \u001b[0m\u001b[1m\u001b[36m> \u001b[0m\u001b[37m\u001b[100mcart-cache (Redis Cluster Shard A)\u001b[0m         \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mService Details: cart-cache\u001b[0m                    \u001b[0m\u001b[9;1H    \u001b[0m\u001b[37mauth-service (OAuth2 / JWT Token Gateway)\u001b[0m  \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97m───────────────────────────────────\u001b[0m            \u001b[0m\u001b[10;1H    \u001b[0m\u001b[37mpayment-gateway (PCI-DSS Vault Connector)\u001b[0m  \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mStatus     : Healthy (100% SLA)\u001b[0m                \u001b[0m\u001b[11;1H    \u001b[0m\u001b[37memail-notifier (SES / SendGrid Dispatcher)\u001b[0m \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mReplicas   : 4 pods active\u001b[0m                     \u001b[0m\u001b[12;1H    \u001b[0m\u001b[37mfraud-detector (ML Anomaly Inference Node)\u001b[0m \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mLatency    : 1.4ms (p99)\u001b[0m                       \u001b[0m\u001b[13;1H    \u001b[0m\u001b[37muser-preferences (DynamoDB Document Store)\u001b[0m \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mCPU Usage  : 24%\u001b[0m                               \u001b[0m\u001b[14;1H    \u001b[0m\u001b[37mbilling-worker (Stripe & Invoice Processor\u001b[0m \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mMemory     : 340 MB / 1024 MB\u001b[0m                  \u001b[0m\u001b[15;1H    \u001b[0m\u001b[37mgraphql-gateway (Federated Schema Endpoint\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[16;1H    \u001b[0m\u001b[37mimage-resizer (Fast WebP Image Transformer\u001b[0m \u001b[0m\u001b[90m│\u001b[0m \u001b[0m\u001b[97mPress [Enter] to inspect telemetry.\u001b[0m            \u001b[0m\u001b[17;1H    \u001b[0m\u001b[37mdelivery-router (Vehicle Route Optimizatio\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[18;1H    \u001b[0m\u001b[37minventory-sync (Warehouse Stock Coordinato\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[19;1H    \u001b[0m\u001b[37mcatalog-index (Elasticsearch Product Catal\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[20;1H    \u001b[0m\u001b[37mlog-aggregator (Vector / ClickHouse Pipeli\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[21;1H    \u001b[0m\u001b[37mrate-limiter (Token Bucket Distributed Fil\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[22;1H    \u001b[0m\u001b[37mmetrics-collector (Prometheus Telemetry Sc\u001b[0m \u001b[0m\u001b[90m│\u001b[0m                                                \u001b[0m\u001b[23;1H                                               \u001b[0m\u001b[90m│\u001b[0m                    