[66.712,"o","\u001b[H\u001b[1;1H\u001b[0m\u001b[38;2;8;132;76m0\u001b[0m\u001b[1m\u001b[96m💎 OPAL\u001b[0m\u001b[38;2;8;132;76m8\u001b[0m\u001b[1m\u001b[96mTUI SHOWCASE ── Slide 21/23: [Text Shader Engine & Compositing\u001b[0m\u001b[38;2;7;125;69mZ\u001b[0m\u001b[1m\u001b[96mFX] ──\u001b[0m\u001b[38;2;6;114;60m+\u001b[0m\u001b[1m\u001b[96m[Post-Processing \u001b[0m\u001b[2;1H\u001b[0m\u001b[90m────────────────────────────────────────────────────────────────────────────────────────────────\u001b[0m\u001b[3;1H\u001b[0m\u001b[92m2\u001b[0m  \u001b[0m\u001b[38;2;2;67;22m5\u001b[0m\u001b[38;2;3;77;30m6\u001b[0m\u001b[92m7\u001b[0m  \u001b[0m\u001b[92mABC\u001b[0m\u001b[38;2;2;67;22mD\u001b[0m    \u001b[0m\u001b[92m$\u001b[0m   \u001b[0m\u001b[38;2;3;77;30m&\u001b[0m     \u001b[0m\u001b[92m1\u001b[0m \u001b[0m\u001b[38;2;3;77;30m3\u001b[0m     \u001b[0m\u001b[38;2;1;55;12m9\u001b[0m \u001b[0m\u001b[38;2;3;77;30mB\u001b[0m  \u001b[0m\u001b[92mE\u001b[0m   \u001b[0m\u001b[38;2;2;67;22m$\u001b[0m        \u001b[0m\u001b[92m0\u001b[0m   \u001b[0m\u001b[92m4\u001b[0m    \u001b[0m\u001b[92m9\u001b[0m     \u001b[0m\u001b[92mF\u001b[0m \u001b[0m\u001b[92mZ\u001b[0m \u001b[0m\u001b[92m#\u001b[0m    \u001b[0m\u001b[92m+\u001b[0m \u001b[0m\u001b[92m=\u001b[0m    \u001b[0m\u001b[92m45\u001b[0m \u001b[0m\u001b[92m7\u001b[0m         \u001b[0m\u001b[4;1H\u001b[0m\u001b[1m\u001b[97m3\u001b[0m  \u001b[0m\u001b[38;2;4;80;33m6\u001b[0m\u001b[38;2;4;89;40m7\u001b[0m\u001b[1m\u001b[36mText\u001b[0m\u001b[1m\u001b[97mC\u001b[0m\u001b[1m\u001b[36mShader\u001b[0m\u001b[1m\u001b[97m#\u001b[0m\u001b[1m\u001b[36mSubsystem\u001b[0m\u001b[1m\u001b[97m2\u001b[0m\u001b[1m\u001b[36m── Mode\u001b[0m\u001b[38;2;3;70;24mA\u001b[0m\u001b[1m\u001b[36m[1]:\u001b[0m\u001b[1m\u001b[97mF\u001b[0m\u001b[1m\u001b[36mMatrix Digital Rain\u001b[0m  \u001b[0m\u001b[1m\u001b[97mA\u001b[0m     \u001b[0m\u001b[1m\u001b[97mX\u001b[0m \u001b[0m\u001b[1m\u001b[97m$\u001b[0m \u001b[0m\u001b[1m\u001b[97m@\u001b[0m    \u001b[0