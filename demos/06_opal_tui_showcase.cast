[0m   \u001b[0m\u001b[48;2;30;27;75m  \u001b[0m\u001b[97mBlit Mode: Replace\u001b[0m\u001b[48;2;30;27;75m        \u001b[0m                                \u001b[0m\u001b[11;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 4: Matrix stream buffer element [4096 \u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m                            \u001b[0m                                \u001b[0m\u001b[12;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 5: Matrix stream buffer element [5120 \u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m  \u001b[0m\u001b[92mAlpha dithered overlay\u001b[0m\u001b[48;2;30;27;75m    \u001b[0m                                \u001b[0m\u001b[13;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 6: Matrix stream buffer element [6144 \u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m                            \u001b[0m                                \u001b[0m\u001b[14;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 7: Matrix stream buffer element [7168 \u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[48;2;30;27;75m                            \u001b[0m                                \u001b[0m\u001b[15;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 8: Matrix stream buffer element [8192 \u001b[0m\u001b[93m│\u001b[0m                                                               \u001b[0m\u001b[16;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 9: Matrix stream buffer element [9216 \u001b[0m\u001b[93m│\u001b[0m                                                               \u001b[0m\u001b[17;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 10: Matrix stream buffer element [1024\u001b[0m\u001b[93m│\u001b[0m   \u001b[0m\u001b[97mScissor Bounds : 42x15\u001b[0m                                      \u001b[0m\u001b[18;1H   \u001b[0m\u001b[93m│\u001b[0m\u001b[38;2;56;239;125mROW 11: Matrix stream buffer element [1126\u001b[0m\u001b[93m│\u001